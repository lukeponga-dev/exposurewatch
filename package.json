{
  "name": "exposurewatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "node build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./.svelte-kit/tsconfig.json",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "postinstall": "node scripts/patch-sveltekit.js"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@types/node": "^22.20.2",
    "prettier": "latest",
    "prettier-plugin-svelte": "latest",
    "svelte": "^5.16.0",
    "svelte-check": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "dependencies": {
    "marked": "^18.0.14"
  }
}
